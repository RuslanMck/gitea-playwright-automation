# Base URL of the Gitea instance under test
GITEA_BASE_URL = http://localhost:3000

# Base URL of the Gitea API under test
GITEA_API_BASE_URL = http://localhost:3000/api/v1/

# Admin user generated by CI using Gitea CLI tool
ADMIN_USER_NAME = admin
ADMIN_PASSWORD = admin_password
ADMIN_EMAIL = admin@example.com

# Admin user token generated by CI using Gitea CLI tool
ADMIN_API_TOKEN = 12345a678901234bc5678e9012345fe67g890123h 

# Test password used in tests
TEST_PASSWORD = test_password

# Test repository name used in name generation
TEST_REPO_NAME = test_repo_name

